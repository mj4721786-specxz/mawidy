# Copy this file to .env.local and fill in your real Supabase project values.
# Get these from: Supabase Dashboard → Project Settings → API
# NEVER commit .env.local to GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used in server-side code (never exposed to the browser).
# Needed for the Admin dashboard to bypass RLS when managing all clinics.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Higgsfield API credentials (Seedance video generation).
# Get these from: https://console.higgsfield.ai (the key is shown only once — save it immediately).
# Server-side only. Format: key-id:key-secret
# NEVER commit the real value to GitHub.
HF_CREDENTIALS=your-key-id:your-key-secret
