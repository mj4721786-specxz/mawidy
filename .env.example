# Copy this file to .env.local and fill in your real Supabase project values.
# Get these from: Supabase Dashboard → Project Settings → API
# NEVER commit .env.local to GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used in server-side code (never exposed to the browser).
# Needed for the Admin dashboard to bypass RLS when managing all clinics.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
